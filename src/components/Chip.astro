---
import Draft from './Draft.astro'
import Duo from './Duo.astro'
import '../styles/chip.css'
import type { Lang } from '../i18n'
import { email, shared } from '../drafts'
import { glyph } from '../glyph'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = shared[lang]
---

<Draft lang={lang} id="chip">
  <main class="board">
    <svg class="drawing" aria-hidden="true">
      <path class="pins" />
      <path class="outline" pathLength="1" />
      <path class="die" pathLength="1" />
    </svg>
    <div class="art" aria-hidden="true">
      <img
        src="/hero/chip-2000.webp"
        srcset="/hero/chip-1100.webp 1100w, /hero/chip-2000.webp 2000w"
        sizes="(max-width: 40rem) 140vw, 70vw"
        alt=""
        width="2000"
        height="1331"
        fetchpriority="high"
      />
    </div>
    <svg class="traces" aria-hidden="true"></svg>

    <div class="copy">
      <h1 class="lit" data-wire="h1">{t.title}</h1>
      <p class="lead lit" data-wire="lead">{t.lead}</p>
      <a class="pill lit" data-wire="pill" href={`mailto:${email}`}><span>{email}</span><span class="pill-node" set:html={glyph('arrow-right')} /></a>
      <Duo class="lit" />
    </div>
  </main>

  <script>
    import '../scripts/chip'
  </script>
</Draft>
