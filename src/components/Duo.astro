---
const founders = [
  { name: 'Martim Ramos', href: 'https://www.linkedin.com/in/martim-c-ramos/', photo: '/founders/martim-ramos.webp' },
  { name: 'Afonso Quintas', href: 'https://www.linkedin.com/in/afonsoquintas/', photo: '/founders/afonso-quintas.webp' },
]
const { class: cls } = Astro.props
---

<ul class:list={['duo', cls]}>
  {founders.map((f) => (
    <li>
      <img src={f.photo} alt="" width="480" height="480" decoding="async" />
      <a href={f.href} target="_blank" rel="noopener noreferrer">{f.name}<span class="sr"> · LinkedIn</span></a>
    </li>
  ))}
</ul>
