---
import Draft from './Draft.astro'
import Work from './Work.astro'
import Contact from './Contact.astro'
import Crew from './Crew.astro'
import '@fontsource/reenie-beanie/latin-400.css'
import '@fontsource/nanum-pen-script/latin-400.css'
import '../styles/typed.css'
import '../styles/light.css'
import type { Lang } from '../i18n'
import { shared } from '../drafts'
import { glyph } from '../glyph'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = shared[lang]

// The headline's last words are written by hand, messily, then read by
// software and set in clean type.
const copy = {
  en: {
    verb: 'We automate',
    tasks: ['moving data between apps', 'logging supplier invoices'],
    finale: 'anything',
    label: 'Type a task your team does by hand',
    hint: 'Click to write your own.',
    tap: 'Tap to write your own.',
    send: 'Tell us what to automate',
    done: 'Your task is now the subject of the email.',
    subject: 'Automate:',
    read: 'Read automatically',
    ignored: 'ignored',
  },
  pt: {
    verb: 'Automatizamos',
    tasks: ['a cópia de encomendas', 'o registo de faturas'],
    finale: 'tudo',
    label: 'Escreva uma tarefa que a sua equipa faz à mão',
    hint: 'Clique para escrever a sua.',
    tap: 'Toque para escrever a sua.',
    send: 'Diga-nos o que automatizar',
    done: 'A sua tarefa é agora o assunto do e-mail.',
    subject: 'Automatizar:',
    read: 'Lido automaticamente',
    ignored: 'ignorado',
  },
}[lang]
---

<Draft lang={lang} id="type">
  <main>
  <section class="typed">
    <div class="say-wrap rise">
    <div class="say">
      <!-- The heading is the verb and the line it stands for; the animated
           task beside it is a picture of that line, hidden from readers. -->
      <h1 class="say-verb">{copy.verb}<span class="sr">{t.title.slice(copy.verb.length)}</span></h1>
      <span class="slot" aria-hidden="true" data-tasks={JSON.stringify(copy.tasks)} data-finale={copy.finale} data-ignored={copy.ignored}>
        <span class="ink">{copy.finale}.</span>
        <span class="hand"><span class="caret"></span></span>
        <span class="read">{copy.read}</span>
        <label class="try-hint" for="task"><Fragment set:html={glyph('pencil-line')} /><span data-tap={copy.tap}>{copy.hint}</span></label>
      </span>
    </div>
    <input class="try" id="task" type="text" name="task" maxlength="40" autocomplete="off" spellcheck="false" enterkeyhint="done" aria-label={copy.label} />
    </div>

    <!-- The foot of the hero: the contact at headline grade, then who we
         are. The way down sits on the rule like a tab. -->
    <div class="band rise">
      <Contact lang={lang} send={copy.send} subject={copy.subject} />
      <div class="band-who">
        <p class="band-lead">{t.lead}</p>
        <Crew lang={lang} />
      </div>
      <a class="btn btn-line band-next" href="#work"><span>{t.next}</span><Fragment set:html={glyph('arrow-down')} /></a>
      <p class="note sr" aria-live="polite" data-done={copy.done}></p>
    </div>
  </section>
  <Work lang={lang} />
  </main>

  <script>
    import '../scripts/typed'
  </script>
</Draft>
