---
import Layout from '../layouts/Layout.astro'
import { copy, paths, type Lang } from '../i18n'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = copy[lang]
const other: Lang = lang === 'en' ? 'pt' : 'en'
const year = new Date().getFullYear()
const founders = [
  { name: 'Martim Ramos', first: 'Martim', last: 'Ramos', href: 'https://www.linkedin.com/in/martim-c-ramos/', photo: '/founders/martim-ramos.webp' },
  { name: 'Afonso Quintas', first: 'Afonso', last: 'Quintas', href: 'https://www.linkedin.com/in/afonsoquintas/', photo: '/founders/afonso-quintas.webp' },
]
// Split a statement into words so each can light as it crosses the screen;
// [[...]] marks the phrase lit in lime.
const words = (text: string) =>
  text.split(/(\[\[.*?\]\])/).filter(Boolean).flatMap((part) => {
    const em = part.startsWith('[[')
    return part.replace(/\[\[|\]\]/g, '').split(/(\s+)/).filter(Boolean).map((w) => ({ w, em, space: /^\s+$/.test(w) }))
  })
const plain = (text: string) => text.replace(/\[\[|\]\]/g, '')
// Lucide line icons (ISC, src/icons/LICENSE), inlined twice: a dim base and a
// lit copy that draws itself when the signal reaches it.
const icons = import.meta.glob('../icons/*.svg', { query: '?raw', import: 'default', eager: true }) as Record<string, string>
const icon = (name: string) => {
  const inner = icons[`../icons/${name}.svg`]
    .replace(/^[\s\S]*?<svg[^>]*>|<\/svg>\s*$/g, '')
    .replace(/<(path|rect|circle|line|polyline|polygon)\b/g, '<$1 pathLength="1"')
    .trim()
  return `<svg viewBox="0 0 24 24"><g class="node-base">${inner}</g><g class="node-lit">${inner}</g></svg>`
}
const stepIcons = ['mouse-pointer-click', 'cpu', 'wrench']
// A plain Lucide glyph for the nodes buttons end in.
const glyph = (name: string) => icons[`../icons/${name}.svg`].replace(/^[\s\S]*?(?=<svg)/, '').replace(/\sclass="[^"]*"/, ' aria-hidden="true"')
---

<Layout lang={lang}>
  <div class="field" aria-hidden="true"></div>
  <svg class="trace" aria-hidden="true" preserveAspectRatio="none">
    <defs><radialGradient id="trace-head"><stop class="head-core" offset="0" /><stop class="head-mid" offset="0.3" /><stop class="head-edge" offset="1" /></radialGradient><linearGradient id="sketch-fade" gradientUnits="userSpaceOnUse" x1="0" x2="0"><stop class="fade-top" offset="0" /><stop class="fade-bottom" offset="1" /></linearGradient></defs>
    <g class="sketch">
      <path pathLength="1" /><path pathLength="1" /><path pathLength="1" /><path class="leg" pathLength="1" /><path class="leg" pathLength="1" />
    </g>
    <path class="trace-base" />
    <path class="trace-glow" />
    <path class="trace-lit" />
    <circle class="trace-head" r="12" fill="url(#trace-head)" />
    <circle class="trace-end" r="3.5" />
  </svg>

  <header class="bar">
    <a class="brand" href={paths[lang]} aria-label={t.nav.home}>
      <img src="/logo.svg" alt="" width="28" height="28" />
      <span>Systems</span>
    </a>
    <div class="bar-end">
      <nav class="lang" aria-label={t.nav.language}>
        <a href={paths.en} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
        <a href={paths.pt} hreflang="pt-PT" lang="pt-PT" aria-current={lang === 'pt' ? 'true' : undefined}>PT</a>
      </nav>
      <a class="pill pill-lime pill-sm" href="#contact"><span>{t.nav.contact}</span><span class="pill-node" set:html={glyph('arrow-right')} /></a>
    </div>
  </header>

  <main>
    <section id="hero" class="cue hero" data-cue="0">
      <div class="art" aria-hidden="true">
        <img
          src="/hero/chip-2000.webp"
          srcset="/hero/chip-1100.webp 1100w, /hero/chip-2000.webp 2000w"
          sizes="(max-width: 40rem) 140vw, 70vw"
          alt=""
          width="2000"
          height="1331"
          fetchpriority="high"
        />
      </div>
      <span class="pin" data-node="pin" aria-hidden="true"></span>
      <div class="hero-copy">
        <h1 class="rise">{t.hero.title[0]}<br /><span class="lime">{t.hero.title[1]}</span></h1>
        <p class="lead rise">
          {t.hero.leadBefore}<a href="#founders">{t.hero.leadLink}</a>{t.hero.leadAfter}
        </p>
        <div class="actions rise">
          <a class="pill pill-lime" href="#contact"><span>{t.hero.contact}</span><span class="pill-node" set:html={glyph('arrow-right')} /></a>
          <a class="pill pill-line pill-down" href="#how-we-work"><span>{t.hero.build}</span><span class="pill-node" set:html={glyph('arrow-down')} /></a>
        </div>
      </div>
      <div class="hero-foot">
        <span>{t.hero.note}</span>
        <span>{t.contact.location}</span>
      </div>
    </section>

    <section id="how-we-work" class="cue build" data-cue="1">
      <div class="build-head">
        <h2>{t.build.title}</h2>
        <p class="build-lead">{t.build.lead}</p>
      </div>
      <ol class="steps">
        {t.build.steps.map((step, i) => (
          <li>
            <h3>
              <span class="node" data-node aria-hidden="true" set:html={icon(stepIcons[i])} />
              <span class="sr">{plain(step.line)}</span>
              {words(step.line).map((x) => (x.space ? ' ' : <span class:list={['w', { em: x.em }]} aria-hidden="true">{x.w}</span>))}
            </h3>
            <p class="step-body">{step.body}</p>
            <ul class="tags">
              {step.tags.map((tag) => <li>{tag}</li>)}
            </ul>
          </li>
        ))}
      </ol>
    </section>

    <section id="case-study" class="cue work" data-cue="2">
      <h2><span class="node" data-node aria-hidden="true" set:html={icon('mail')} />{t.work.title}</h2>
      <div class="case">
        <div class="case-copy reveal">
          <h3>{t.work.caseTitle[0]} {t.work.caseTitle[1]}</h3>
          {t.work.body.map((para) => <p>{para}</p>)}
        </div>
        <dl class="figures">
          {t.work.stats.map((s) => (
            <div class="figure reveal">
              <dt>{s.label}</dt>
              <dd>{s.value}</dd>
            </div>
          ))}
        </dl>
      </div>
    </section>

    <section id="founders" class="cue founders" data-cue="3">
      <div class="founders-copy">
        <h2><span class="via" data-node aria-hidden="true"></span>{t.founders.title}</h2>
        <p>{t.founders.body}</p>
      </div>
      <div class="team">
        <ul class="people">
          {founders.map((f) => (
            <li class="reveal">
              <img src={f.photo} alt={f.name} width="480" height="480" loading="lazy" decoding="async" />
              <a href={f.href} target="_blank" rel="noopener noreferrer">
                <span class="first">{f.first}</span>
                <span class="last"><b>{f.last[0]}</b>{f.last.slice(1)}</span>
                <span class="sr"> · LinkedIn</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="team-mark" aria-hidden="true">Systems</p>
      </div>
    </section>

    <section id="contact" class="cue contact" data-cue="4">
      <p class="cta reveal">{t.contact.cta}</p>
      <div class="reach">
        <a class="pill pill-lime pill-lg" href="mailto:contact@rqsystems.pt"><span>contact@rqsystems.pt</span><span class="pill-node" set:html={glyph('arrow-right')} /></a>
        <button class="pill pill-line" type="button" data-copy="contact@rqsystems.pt" data-copied={t.contact.copied}><span>{t.contact.copy}</span><span class="pill-node" set:html={glyph('copy') + glyph('check')} /></button>
      </div>
      <ul class="faces reveal">
        {founders.map((f) => (
          <li>
            <img src={f.photo} alt="" width="640" height="800" loading="lazy" decoding="async" />
            <a href={f.href} target="_blank" rel="noopener noreferrer">{f.name}<span class="sr"> · LinkedIn</span></a>
          </li>
        ))}
      </ul>
      <footer class="foot" data-node="end">
        <div class="foot-meta">
          <span>{t.contact.location}</span>
          <span>© {year} RQ Systems</span>
        </div>
        <nav class="foot-nav" aria-label={t.contact.footer}>
          <a href="#how-we-work">{t.contact.nav.build}</a>
          <a href="#case-study">{t.contact.nav.work}</a>
          <a href={paths[other]} hreflang={other === 'pt' ? 'pt-PT' : 'en'} lang={other === 'pt' ? 'pt-PT' : 'en'}>{other === 'pt' ? 'Português' : 'English'}</a>
        </nav>
      </footer>
    </section>
  </main>


  <script>
    import '../scripts/cues'
    import '../scripts/trace'
  </script>
</Layout>
