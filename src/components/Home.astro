---
import Draft from './Draft.astro'
import Work from './Work.astro'
import Contact from './Contact.astro'
import Crew from './Crew.astro'
import Services from './Services.astro'
import '../styles/home.css'
import '../styles/light.css'
import type { Lang } from '../i18n'
import { shared } from '../drafts'
import { glyph } from '../glyph'

interface Props { lang: Lang }
const { lang } = Astro.props
const t = shared[lang]

// The headline says it plainly, with the contact under it; who we are
// sits beside it, the two of us side by side.
const copy = {
  en: { lead: 'We automate', rest: ' repetitive business processes.', send: 'Contact us' },
  pt: { lead: 'Automatizamos', rest: ' os processos repetitivos das empresas.', send: 'Contacte-nos' },
}[lang]
---

<Draft lang={lang} id="type">
  <main>
    <section class="typed">
      <div class="hero-main">
        <div class="say-wrap">
          <h1 class="say"><span>{copy.lead}</span><span class="say-rest">{copy.rest}</span></h1>
          <p class="say-sub">{t.lead}</p>
        </div>
        <Contact lang={lang} send={copy.send} />
      </div>
      <div class="hero-side">
        <Crew lang={lang} />
      </div>
      <a class="btn btn-line band-next" href="#servicos"><span>{t.next}</span><Fragment set:html={glyph('arrow-down')} /></a>
    </section>
    <Services lang={lang} />
    <Work lang={lang} />
  </main>
</Draft>
