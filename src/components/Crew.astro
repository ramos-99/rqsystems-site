---
import type { Lang } from '../i18n'
import { founders, shared } from '../drafts'
import { glyph } from '../glyph'

// The two of us: face and name each, then the line we share (what we
// study, where, and how we work).
interface Props { lang: Lang; class?: string }
const { lang, class: cls } = Astro.props
const t = shared[lang]
---

<div class:list={['crew', cls]}>
  <ul class="crew-people">
    {founders.map((f) => (
      <li class="crew-person">
        <span class="crew-photo"><img src={f.photo} alt="" width="640" height="640" decoding="async" /></span>
        <span class="crew-id"><strong>{f.name}</strong></span>
        <a class="crew-in" href={f.href} target="_blank" rel="noopener noreferrer" aria-label={`${f.name}, LinkedIn`} set:html={glyph('linkedin')} />
      </li>
    ))}
  </ul>
  <p class="crew-text">{t.crew}</p>
</div>
