---
import type { Lang } from '../i18n'
import { founders, shared } from '../drafts'

// The two of us: overlapping faces and one sentence, the first names
// linking to LinkedIn.
interface Props { lang: Lang; class?: string }
const { lang, class: cls } = Astro.props
const t = shared[lang]
const [a, b] = founders
const link = (f: (typeof founders)[number]) => ({ href: f.href, target: '_blank', rel: 'noopener noreferrer' })
---

<div class:list={['crew', cls]}>
  <span class="crew-faces">{founders.map((f) => <img src={f.photo} alt="" width="480" height="480" decoding="async" />)}</span>
  <p class="crew-text">{t.we[0]}<a {...link(a)}>{a.first}</a>{t.we[1]}<a {...link(b)}>{b.first}</a>{t.we[2]}</p>
</div>
