---
import Layout from '../layouts/Layout.astro'
import '../styles/draft.css'
import type { Lang } from '../i18n'
import { design, email, shared, type Draft } from '../drafts'

interface Props { lang: Lang; id: Draft }
const { lang, id } = Astro.props
const { paths, index, theme } = design(id)
const t = shared[lang]
const year = new Date().getFullYear()
---

<Layout lang={lang} paths={paths} noindex={!index} theme={theme}>
  <header class="bar">
    <a class="brand" href={paths[lang]} aria-label={t.home}>
      <img src="/logo.svg" alt="" width="28" height="28" />
      <span>RQ Systems</span>
    </a>
    <nav class="lang" aria-label={t.language}>
      <a href={paths.en} hreflang="en" lang="en" aria-current={lang === 'en' ? 'true' : undefined}>EN</a>
      <a href={paths.pt} hreflang="pt-PT" lang="pt-PT" aria-current={lang === 'pt' ? 'true' : undefined}>PT</a>
    </nav>
  </header>

  <slot />

  <footer class="tiny">
    <span>{t.location}</span>
    <a href={`mailto:${email}`}>{email}</a>
    <span>© {year} RQ Systems</span>
  </footer>
</Layout>
