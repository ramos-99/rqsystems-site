---
import '../styles/services.css'
import type { Lang } from '../i18n'

// What we automate, by area of the business rather than task by task:
// every process belongs to one of them, so no one's work is missing.
interface Props { lang: Lang }
const { lang } = Astro.props

const copy = {
  en: {
    title: 'Process automation across the business',
    areas: [
      ['Finance', 'Invoices, payments and bank reconciliations, with no manual data entry.'],
      ['Operations', 'Orders, stock and documents kept in sync across systems, with no manual copying.'],
      ['Sales', 'Quotes, client records and sales follow-up, with no duplicated work.'],
      ['Admin and HR', 'Timesheets, holidays, expenses and records, with no paper processes.'],
    ],
  },
  pt: {
    title: 'Automação de processos em todas as áreas da empresa',
    areas: [
      ['Finanças', 'Faturas, pagamentos e conciliações bancárias, sem introdução manual de dados.'],
      ['Operações', 'Encomendas, stock e documentos sincronizados entre sistemas, sem cópia manual.'],
      ['Comercial', 'Propostas, clientes e acompanhamento comercial, sem duplicação de trabalho.'],
      ['Administração e RH', 'Registo de horas, férias, despesas e documentação, sem processos em papel.'],
    ],
  },
}[lang]
---

<section class="services" id="servicos" aria-labelledby="servicos-t">
  <div class="sv-head">
    <h2 id="servicos-t">{copy.title}</h2>
  </div>
  <ul class="sv-areas">
    {copy.areas.map(([name, text]) => (
      <li>
        <h3>{name}</h3>
        <p>{text}</p>
      </li>
    ))}
  </ul>
</section>
